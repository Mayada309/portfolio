{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "portfolio",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "portfolio"
    }
  ],
  // Image optimization for next/image (Cloudflare Images binding)
  "images": {
    "binding": "IMAGES"
  },
  // Attach the domain: Cloudflare creates the DNS records + certificate on deploy
  "routes": [
    { "pattern": "mayadashaaban.dev", "custom_domain": true },
    { "pattern": "www.mayadashaaban.dev", "custom_domain": true }
  ],
  "observability": { "enabled": true }
}
